# GeneReason Backend - Production Environment Configuration
# Copy this file to .env.production and fill in the values

# Application Settings
APP_NAME=GeneReason API
APP_VERSION=0.1.0
APP_ENV=production
CORS_ORIGINS=["https://genereason.com","https://www.genereason.com"]

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/genereason

# Supabase Configuration (if using Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Configuration (GLM-4.7)
LLM_API_URL=https://api.example.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=glm-4-plus
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# FalkorDB Configuration (Graph Database)
FALKORDB_HOST=your-falkordb-host
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=your-falkordb-password
FALKORDB_GRAPH_NAME=genereason_kg

# Redis Cache Configuration
REDIS_URL=redis://your-redis-host:6379/0
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL=3600
REDIS_CACHE_PREFIX=genereason:

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Feature Flags
USE_MOCK_DATA=false
USE_MOCK_LLM=false
USE_MOCK_GRAPH=false
REQUIRE_AUTH=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
